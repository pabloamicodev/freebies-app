{
  "framework": "react-router",
  "regions": [
    "pdx1"
  ],
  "installCommand": "cd ../.. && pnpm install --frozen-lockfile",
  "buildCommand": "cd ../.. && node scripts/vercel-migrate.mjs && cd apps/shopify-admin && pnpm exec react-router build",
  "outputDirectory": "build/client",
  "alias": [
    "freebies-app-shopify-admin.vercel.app"
  ],
  "crons": [
    {
      "path": "/api/cron/offers",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/catalog-sync",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/skio-shipping",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/analytics-cleanup",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/apps/promo-engine/evaluate",
      "schedule": "* * * * *"
    }
  ]
}
