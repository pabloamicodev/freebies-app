{% comment %}
  Promo Engine — Volume Discount Block
  Place on product pages to show quantity tier discounts.
  The block reads the current product variant from the page context.
{% endcomment %}

<promo-volume-discount
  offer-id="{{ block.settings.offer_id | escape }}"
  variant-id="{{ product.selected_or_first_available_variant.id | prepend: 'gid://shopify/ProductVariant/' }}"
  currency="{{ cart.currency.iso_code }}"
  {{ block.shopify_attributes }}
></promo-volume-discount>

<script>
  // Update variant-id on every promo-volume-discount element when the variant
  // selection changes (product page). Registered once globally (not once per
  // block instance) so N blocks on one page don't add N duplicate listeners.
  document.addEventListener('DOMContentLoaded', function() {
    if (window.__promoVolumeDiscountListenerInstalled) return;
    window.__promoVolumeDiscountListenerInstalled = true;
    document.addEventListener('variant:changed', function(e) {
      var variantId = e.detail && e.detail.variant && e.detail.variant.id;
      if (!variantId) return;
      var gid = 'gid://shopify/ProductVariant/' + variantId;
      document.querySelectorAll('promo-volume-discount').forEach(function(el) {
        el.setAttribute('variant-id', gid);
      });
      window.dispatchEvent(new CustomEvent('promo-engine:product-changed', {
        detail: { variantId: gid }
      }));
    });
  });
</script>

{% schema %}
{
  "name": "Volume Discount",
  "target": "section",
  "settings": [
    {
      "type": "text",
      "id": "offer_id",
      "label": "Offer ID",
      "info": "The volume discount offer UUID from the admin."
    }
  ]
}
{% endschema %}
