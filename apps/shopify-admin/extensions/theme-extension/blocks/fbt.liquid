{% comment %}
  Promo Engine — Frequently Bought Together Block
  Place on product pages to show FBT recommendations.
  The Preact component is initialized by the app embed runtime.
{% endcomment %}

<div
  id="pe-fbt-{{ block.id }}"
  data-promo-widget="fbt"
  data-offer-id="{{ block.settings.offer_id | escape }}"
  data-currency="{{ cart.currency.iso_code }}"
  {{ block.shopify_attributes }}
></div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    var container = document.getElementById('pe-fbt-{{ block.id }}');
    if (!container) return;
    var attempts = 0;

    var mounted = false;

    // The runtime's own evaluation carries the upsells and the pageGate for the stamp this page would write,
    // so the block issues no request of its own.
    function mount(result) {
      if (mounted || !result) return;
      var offerId = container.dataset.offerId;
      var currency = container.dataset.currency || 'USD';
      var sessionId = sessionStorage.getItem('promo_engine_session_id') || 'anon';
      var upsell = result.upsells && result.upsells.find(function(u) {
        return (!offerId || u.offerId === offerId) && window.PromoEngine.canPromise(result, u.offerId, 'add');
      });
      // The evaluate endpoint returns one recommended product per offer,
      // not a full "frequently bought together" set — show it alongside
      // the current product rather than a curated relatedProducts list.
      if (!upsell || !upsell.product) return;
      mounted = true;
      var mainProduct = Object.assign({}, upsell.product, { priceCents: upsell.product.originalPriceCents });
      window.initFbtWidget(container, {
        offerId: upsell.offerId,
        mainProduct: mainProduct,
        relatedProducts: [upsell.product],
        title: upsell.message || 'Frequently bought together',
        buttonText: upsell.buttonText || 'Add to cart',
        discountPercent: upsell.discountPercent || 0,
        maxProducts: 1,
        layout: 'amazon'
      }, currency, sessionId);
    }

    // Wait for promo engine runtime to load, then init FBT
    function tryInit() {
      attempts += 1;
      if (window.PromoEngine && window.initFbtWidget) {
        window.addEventListener('promo-engine:evaluation-completed', function(e) { mount(e.detail); });
        mount(window.PromoEngine.lastResult());
      } else if (attempts < 50) {
        setTimeout(tryInit, 200);
      } else {
        container.setAttribute('data-promo-engine-error', 'true');
        console.warn('[Promo Engine] FBT block could not load: app embed is not enabled.');
      }
    }
    tryInit();
  });
</script>

{% schema %}
{
  "name": "FBT Upsell",
  "target": "section",
  "settings": [
    {
      "type": "text",
      "id": "offer_id",
      "label": "Offer ID",
      "info": "The FBT offer UUID. Leave empty for the first active FBT offer."
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "amazon", "label": "Amazon style (horizontal)" },
        { "value": "stacked", "label": "Stacked (vertical)" }
      ],
      "default": "amazon"
    }
  ]
}
{% endschema %}
