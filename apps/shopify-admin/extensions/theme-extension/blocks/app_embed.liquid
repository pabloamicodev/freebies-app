{% comment %}
  Promo Engine App Embed
  ─────────────────────
  Auto-injected on every page when enabled in the theme editor under "App embeds".
  Injects the runtime config and loads the compiled promo-engine.js bundle.

  Settings: debug_mode and cart_debounce_ms.
  specificLinkParams: app-owned shop metafield promo_engine.specific_link_params (JSON list of query-param
  names used by specific-link conditions); the runtime falls back to ["freegifts_code"] when it is absent.
  i18n: widget strings from locales/*.json (merchant-translatable).
{% endcomment %}

{%- liquid
  assign pe_locale = request.locale.iso_code | default: 'en'
  assign pe_currency = cart.currency.iso_code | default: shop.currency
  assign pe_debug = false
  if block.settings.debug_mode == true
    assign pe_debug = true
  endif
  assign pe_debounce = block.settings.cart_debounce_ms | default: 300
-%}

<script>
  window.__promoEngineConfig = {
    shopDomain: {{ shop.permanent_domain | json }},
    locale:     {{ pe_locale | json }},
    currency:   {{ pe_currency | json }},
    marketId:   {{ localization.market.id | json }},
    marketHandle: {{ localization.market.handle | json }},
    countryCode: {{ localization.country.iso_code | json }},
    debug:      {{ pe_debug | json }},
    debounceMs: {{ pe_debounce }},
    evalEndpoint: "/apps/promo-engine/evaluate",
    cartItemCount: {{ cart.item_count | json }},
    specificLinkParams: {{ app.metafields.promo_engine.specific_link_params.value | json }},
    i18n: {
      close: {{ 'widgets.close' | t | json }},
      giftOffer: {{ 'widgets.giftOffer' | t | json }},
      giftSliderClose: {{ 'widgets.giftSliderClose' | t | json }},
      giftsUpdating: {{ 'widgets.giftsUpdating' | t | json }},
      progress: {{ 'widgets.progress' | t: percent: '{{percent}}' | json }},
      todayOffers: {{ 'widgets.todayOffers' | t | json }},
      todayDeals: {{ 'widgets.todayDeals' | t | json }},
      offersAvailable: {{ 'widgets.offersAvailable' | t: count: '{{count}}' | json }},
      offerAvailable: {{ 'widgets.offerAvailable' | t | json }},
      bundleSearch: {{ 'widgets.bundleSearch' | t | json }},
      bundleAdd: {{ 'widgets.bundleAdd' | t: title: '{{title}}' | json }},
      bundleRemove: {{ 'widgets.bundleRemove' | t: title: '{{title}}' | json }},
      fbtAdd: {{ 'widgets.fbtAdd' | t: count: '{{count}}', price: '{{price}}' | json }},
      volumeTier: {{ 'widgets.volumeTier' | t: quantity: '{{quantity}}', price: '{{price}}' | json }}
    }
  };
</script>

<script src="{{ 'promo-engine.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Promo Engine",
  "target": "body",
  "settings": [
    {
      "type": "checkbox",
      "id": "debug_mode",
      "label": "Debug mode",
      "default": false,
      "info": "Logs evaluation details to browser console. Disable in production."
    },
    {
      "type": "range",
      "id": "cart_debounce_ms",
      "label": "Cart evaluation delay (ms)",
      "min": 100,
      "max": 1000,
      "step": 50,
      "default": 300,
      "info": "How long to wait after a cart change before evaluating offers."
    }
  ]
}
{% endschema %}
