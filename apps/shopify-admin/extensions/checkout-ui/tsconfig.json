{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "jsx": "react",
    "jsxFactory": "h",
    "types": [
      "@shopify/ui-extensions/checkout",
      "@shopify/ui-extensions/purchase.checkout.block.render",
      "@shopify/ui-extensions/purchase.checkout.actions.render-before"
    ]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"]
}
